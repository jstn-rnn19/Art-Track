<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_color_background"
    tools:context=".ArtistCommissionsView">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Back"
        android:src="?attr/homeAsUpIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/fraunces_medium"
        android:text="Commissions"
        android:textColor="#1D1B20"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/btnBack"
        app:layout_constraintTop_toTopOf="@+id/btnBack" />

    <!-- Tabs Layout (Active | Completed | Closed) -->
    <LinearLayout
        android:id="@+id/tabsLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBack">

        <Button
            android:id="@+id/tabActive"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/role_card_selected"
            android:fontFamily="@font/dm_sans_bold"
            android:text="Active"
            android:textAllCaps="false"
            android:textColor="#7351B5"
            android:textSize="13sp" />

        <Button
            android:id="@+id/tabCompleted"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/dm_sans"
            android:text="Completed"
            android:textAllCaps="false"
            android:textColor="#5A5760"
            android:textSize="13sp" />

        <Button
            android:id="@+id/tabClosed"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/dm_sans"
            android:text="Closed"
            android:textAllCaps="false"
            android:textColor="#5A5760"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Search Bar -->
    <EditText
        android:id="@+id/etSearchCommissions"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/edit_text_rounded_bg"
        android:fontFamily="@font/dm_sans"
        android:hint="Search by title or client"
        android:inputType="text"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="#1D1B20"
        android:textColorHint="#A4A1A4"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabsLayout" />

    <!-- Filter Chips Row -->
    <HorizontalScrollView
        android:id="@+id/chipsScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/etSearchCommissions">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="4dp">

            <Button
                android:id="@+id/chipAll"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/role_card_selected"
                android:fontFamily="@font/dm_sans_bold"
                android:text="All"
                android:textAllCaps="false"
                android:textColor="#7351B5"
                android:textSize="13sp" />

            <Button
                android:id="@+id/chipActive"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_unselected_bg"
                android:fontFamily="@font/dm_sans_bold"
                android:text="Active"
                android:textAllCaps="false"
                android:textColor="#5A5760"
                android:textSize="13sp" />

            <Button
                android:id="@+id/chipNeedsAction"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_unselected_bg"
                android:fontFamily="@font/dm_sans_bold"
                android:text="Needs my action"
                android:textAllCaps="false"
                android:textColor="#5A5760"
                android:textSize="13sp" />

            <Button
                android:id="@+id/chipWaiting"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/chip_unselected_bg"
                android:fontFamily="@font/dm_sans_bold"
                android:text="Waiting on client"
                android:textAllCaps="false"
                android:textColor="#5A5760"
                android:textSize="13sp" />

            <Button
                android:id="@+id/chipDelayed"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/chip_unselected_bg"
                android:fontFamily="@font/dm_sans_bold"
                android:text="Delayed"
                android:textAllCaps="false"
                android:textColor="#5A5760"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavArtist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/chipsScroll">

        <LinearLayout
            android:id="@+id/commissionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="24dp">

            <!-- Dynamically populated commission cards -->
        </LinearLayout>
    </ScrollView>

    <!-- Bottom Navigation Bar for Artist -->
    <LinearLayout
        android:id="@+id/bottomNavArtist"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="#FFFDFA"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Tab 1: Home -->
        <LinearLayout
            android:id="@+id/navTabHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Home"
                android:src="@drawable/home_3917033" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/dm_sans"
                android:text="Home"
                android:textColor="#5A5760"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 2: Requests -->
        <LinearLayout
            android:id="@+id/navTabRequests"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Requests"
                android:src="@drawable/client_24" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/dm_sans"
                android:text="Requests"
                android:textColor="#5A5760"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 3: Commissions (Active) -->
        <LinearLayout
            android:id="@+id/navTabCommissions"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Commissions"
                android:src="@drawable/palette_3917489" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/dm_sans_bold"
                android:text="Commissions"
                android:textColor="#7351B5"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 4: Payments -->
        <LinearLayout
            android:id="@+id/navTabPayments"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Payments"
                android:src="@drawable/payment_icon" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/dm_sans"
                android:text="Payments"
                android:textColor="#5A5760"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Tab 5: Profile -->
        <LinearLayout
            android:id="@+id/navTabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Profile"
                android:src="@drawable/user_3917688" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/dm_sans"
                android:text="Profile"
                android:textColor="#5A5760"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>