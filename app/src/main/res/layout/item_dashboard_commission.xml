<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@drawable/role_card_unselected"
    android:padding="16dp">

    <!-- Artwork Thumbnail -->
    <ImageView
        android:id="@+id/ivArtwork"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/circle_shape"
        android:backgroundTint="#3A2D56"
        android:contentDescription="Artwork thumbnail"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Commission Title -->
    <TextView
        android:id="@+id/tvCommissionTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:fontFamily="@font/fraunces_medium"
        android:text="Moonlit Kitsune Portrait"
        android:textColor="#1D1B20"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivArtwork"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Artist Name -->
    <TextView
        android:id="@+id/tvArtistName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/dm_sans"
        android:text="Artist: Mika Reyes"
        android:textColor="#5A5760"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivArtwork"
        app:layout_constraintTop_toBottomOf="@+id/tvCommissionTitle" />

    <!-- Status Badge -->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/badge_bg"
        android:fontFamily="@font/dm_sans_bold"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="AWAITING APPROVAL"
        android:textColor="#7A4A00"
        android:textSize="11sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@+id/ivArtwork"
        app:layout_constraintTop_toBottomOf="@+id/tvArtistName" />

    <!-- Due Date -->
    <TextView
        android:id="@+id/tvDueDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/dm_sans"
        android:text="Due Oct 20"
        android:textColor="#5A5760"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvArtistName" />

</androidx.constraintlayout.widget.ConstraintLayout>