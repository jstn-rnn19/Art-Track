<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WelcomeView">

    <ImageView
        android:id="@+id/primary_background"
        android:layout_width="417dp"
        android:layout_height="497dp"
        android:background="#FFFDFA"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/rectangle" />

    <ImageView
        android:id="@+id/welcomeimageFinished_3"
        android:layout_width="222dp"
        android:layout_height="353dp"
        android:rotation="-9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.137"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        android:visibility="invisible"
        app:srcCompat="@drawable/sketch_two" />

    <ImageView
        android:id="@+id/welcomeimageFinished_2"
        android:layout_width="222dp"
        android:layout_height="353dp"
        android:rotation="15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.915"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.142"
        android:visibility="invisible"
        app:srcCompat="@drawable/sketch" />

    <ImageView
        android:id="@+id/welcomeImageFinished"
        android:layout_width="222dp"
        android:layout_height="353dp"
        android:rotation="-4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.243"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.38"
        android:visibility="invisible"
        app:srcCompat="@drawable/finished" />

    <ImageView
        android:id="@+id/primary_background"
        android:layout_width="412dp"
        android:layout_height="454dp"
        android:background="#FFFDFA"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/rectangle_background" />

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="220dp"
        android:layout_height="78dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.052"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.54"
        app:srcCompat="@drawable/artracklogo" />

    <TextView
        android:id="@+id/welcometitle"
        android:layout_width="402dp"
        android:layout_height="134dp"
        android:fontFamily="@font/fraunces_medium"
        android:text="Follow you commission from first sketch to final download"
        android:textSize="34sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.67" />

    <TextView
        android:id="@+id/welcomedescription"
        android:layout_width="376dp"
        android:layout_height="52dp"
        android:fontFamily="@font/dm_sans_semibold"
        android:text="Artists manage requests, payments and revisions. Clients always see where their artwork stands."
        android:textColor="#27242B"
        android:textStyle="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.485"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.786" />

    <Button
        android:id="@+id/welcomeViewCreateBtn"
        android:layout_width="342dp"
        android:layout_height="62dp"
        android:fontFamily="@font/dm_sans_semibold"
        android:text="Create Account"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.87" />

    <Button
        android:id="@+id/welcomeViewSignIn"
        android:layout_width="342dp"
        android:layout_height="62dp"
        android:backgroundTint="#FFFFFF"
        android:fontFamily="@font/dm_sans_semibold"
        android:text="I already have an account"
        android:textColor="#27242B"
        app:layout_constraintBottom_toBottomOf="@+id/primary_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.507"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.98"
        app:strokeColor="#2627242B"
        app:strokeWidth="2dp" />


</androidx.constraintlayout.widget.ConstraintLayout>